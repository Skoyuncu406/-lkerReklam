
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  order       Int            @default(0)
  active      Boolean        @default(true)
  images      ServiceImage[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}


model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  src       String?
  alt       String?
  publicId  String?
  order     Int      @default(0)

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([serviceId])
}


model Reference {
  id        String   @id @default(cuid())
  name      String?
  logo      String?
  publicId  String?
  order     Int      @default(0)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
